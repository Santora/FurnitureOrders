@host = https://localhost:7222

###############################################################
# ZÁKAZNÍCI
###############################################################

### Prázdný požadavek: čekáme 400 (název povinný)
POST {{host}}/api/customers
Content-Type: application/json

{ "type": 1 }

### Špatný e-mail: čekáme 400
POST {{host}}/api/customers
Content-Type: application/json

{ "name": "Test s.r.o.", "type": 1, "email": "neplatny" }

### Číslo se vygeneruje (Z00001...): čekáme 201
# @name createCustomer
POST {{host}}/api/customers
Content-Type: application/json

{ "name": "Http Test s.r.o.", "type": 1, "email": "http@example.com", "city": "Brno" }

### Duplicitní číslo zákazníka: čekáme 400
POST {{host}}/api/customers
Content-Type: application/json

{ "customerNumber": "{{createCustomer.response.body.$.customerNumber}}", "name": "Jiná firma", "type": 1 }

### Seznam, hledání a řazení
GET {{host}}/api/customers?search=http&sortBy=name&desc=true

### Detail
GET {{host}}/api/customers/{{createCustomer.response.body.$.id}}

### Úprava
PUT {{host}}/api/customers/{{createCustomer.response.body.$.id}}
Content-Type: application/json

{ "id": {{createCustomer.response.body.$.id}}, "customerNumber": "{{createCustomer.response.body.$.customerNumber}}", "name": "Http Test upraveno", "type": 1, "isActive": true }

### Deaktivace
PATCH {{host}}/api/customers/{{createCustomer.response.body.$.id}}/active
Content-Type: application/json

{ "isActive": false }

### Jen neaktivní
GET {{host}}/api/customers?isActive=false

### Neexistující záznam: čekáme 404
GET {{host}}/api/customers/999999

###############################################################
# MATERIÁLY
###############################################################

### Záporná cena a chybějící jednotka: čekáme 400
POST {{host}}/api/materials
Content-Type: application/json

{ "code": "HM001", "name": "Lamino bílé 18 mm", "type": 1, "purchasePrice": -5 }

### Správně: čekáme 201
# @name createMaterial
POST {{host}}/api/materials
Content-Type: application/json

{ "code": "HM001", "name": "Lamino bílé 18 mm", "type": 1, "unit": "m2", "purchasePrice": 250.50, "colorOrDecor": "Bílá" }

### Duplicitní kód: čekáme 400
POST {{host}}/api/materials
Content-Type: application/json

{ "code": "HM001", "name": "Jiný", "type": 2, "unit": "ks" }

### Seznam podle typu a ceny
GET {{host}}/api/materials?type=1&sortBy=price&desc=true

### Hledání
GET {{host}}/api/materials?search=lamino

### Deaktivace
PATCH {{host}}/api/materials/{{createMaterial.response.body.$.id}}/active
Content-Type: application/json

{ "isActive": false }

###############################################################
# OPERACE
###############################################################

### Záporná doba přípravy a chybějící název: čekáme 400
POST {{host}}/api/operations
Content-Type: application/json

{ "code": "HO001", "defaultSetupMinutes": -1 }

### Správně: čekáme 201
# @name createOperation
POST {{host}}/api/operations
Content-Type: application/json

{ "code": "HO001", "name": "Formátování", "workplace": "Formátovací pila", "defaultSetupMinutes": 10, "defaultRunMinutes": 5, "hourlyRate": 600 }

### Duplicitní kód: čekáme 400
POST {{host}}/api/operations
Content-Type: application/json

{ "code": "HO001", "name": "Jiná operace" }

### Seznam podle pracoviště
GET {{host}}/api/operations?workplace=Formátovací pila&sortBy=rate

### Nabídka pracovišť
GET {{host}}/api/operations/workplaces

### Detail
GET {{host}}/api/operations/{{createOperation.response.body.$.id}}

### Deaktivace
PATCH {{host}}/api/operations/{{createOperation.response.body.$.id}}/active
Content-Type: application/json

{ "isActive": false }


###############################################################
# VÝROBKY
###############################################################

### Chybí cena a záporná šířka: čekáme 400
POST {{host}}/api/products
Content-Type: application/json

{ "code": "HP001", "name": "Psací stůl Alfa", "unit": "ks", "width": -1 }

### Správně: čekáme 201
# @name createProduct
POST {{host}}/api/products
Content-Type: application/json

{ "code": "HP001", "name": "Psací stůl Alfa", "unit": "ks", "salesPrice": 4990, "productGroup": "Stoly", "width": 140, "height": 75, "depth": 70, "deliveryDays": 14 }

### Duplicitní kód: čekáme 400
POST {{host}}/api/products
Content-Type: application/json

{ "code": "HP001", "name": "Jiný", "unit": "ks", "salesPrice": 100 }

### Seznam podle skupiny
GET {{host}}/api/products?group=Stoly&sortBy=price&desc=true

### Nabídka skupin
GET {{host}}/api/products/groups

### Deaktivace
PATCH {{host}}/api/products/{{createProduct.response.body.$.id}}/active
Content-Type: application/json

{ "isActive": false }


###############################################################
# TECHNOLOGICKÝ POSTUP VÝROBKU
# Sekce je soběstačná: vytváří si vlastní data s náhodnými kódy.
# Spouštěj shora dolů.
###############################################################

### Příprava: výrobek
# @name rtProduct
POST {{host}}/api/products
Content-Type: application/json

{ "code": "RP{{$randomInt}}", "name": "Postup test", "unit": "ks", "salesPrice": 1000 }

### Příprava: materiál
# @name rtMaterial
POST {{host}}/api/materials
Content-Type: application/json

{ "code": "RM{{$randomInt}}", "name": "Postup materiál", "type": 1, "unit": "m2" }

### Příprava: neaktivní materiál
# @name rtMaterialInactive
POST {{host}}/api/materials
Content-Type: application/json

{ "code": "RN{{$randomInt}}", "name": "Postup neaktivní", "type": 1, "unit": "ks", "isActive": false }

### Příprava: operace 1
# @name rtOperation1
POST {{host}}/api/operations
Content-Type: application/json

{ "code": "RO{{$randomInt}}", "name": "Postup formátování", "workplace": "Formátovací pila" }

### Příprava: operace 2
# @name rtOperation2
POST {{host}}/api/operations
Content-Type: application/json

{ "code": "RQ{{$randomInt}}", "name": "Postup olepování", "workplace": "Olepovačka" }

### Materiál: neaktivní nelze přiřadit: čekáme 400
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/materials
Content-Type: application/json

{ "materialId": {{rtMaterialInactive.response.body.$.id}}, "quantity": 2 }

### Materiál: chybí materiál, množství 0: čekáme 400
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/materials
Content-Type: application/json

{ "quantity": 0 }

### Materiál: neexistující materiál: čekáme 400
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/materials
Content-Type: application/json

{ "materialId": 999999, "quantity": 1 }

### Materiál: výrobek neexistuje: čekáme 404
POST {{host}}/api/products/999999/materials
Content-Type: application/json

{ "materialId": {{rtMaterial.response.body.$.id}}, "quantity": 1 }

### Materiál: správně, jednotka se převezme z materiálu (m2): čekáme 201
# @name rtProductMaterial
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/materials
Content-Type: application/json

{ "materialId": {{rtMaterial.response.body.$.id}}, "quantity": 2.5, "wastePercent": 5 }

### Materiál: úprava: čekáme 200
PUT {{host}}/api/products/{{rtProduct.response.body.$.id}}/materials/{{rtProductMaterial.response.body.$.id}}
Content-Type: application/json

{ "materialId": {{rtMaterial.response.body.$.id}}, "quantity": 3, "wastePercent": 10, "note": "Upraveno" }

### Materiály výrobku: čekáme jeden řádek, množství 3
GET {{host}}/api/products/{{rtProduct.response.body.$.id}}/materials

### Operace: chybí operace: čekáme 400
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/operations
Content-Type: application/json

{ "setupMinutes": 5 }

### Operace 1: čekáme 201, pořadí 1
# @name rtProductOperation1
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/operations
Content-Type: application/json

{ "operationId": {{rtOperation1.response.body.$.id}}, "setupMinutes": 10, "runMinutesPerUnit": 2.5, "workInstructions": "Nařezat dle výkresu" }

### Operace 2: čekáme 201, pořadí 2
# @name rtProductOperation2
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/operations
Content-Type: application/json

{ "operationId": {{rtOperation2.response.body.$.id}}, "setupMinutes": 5, "runMinutesPerUnit": 1 }

### Operace: pořadí 1 = formátování, 2 = olepování
GET {{host}}/api/products/{{rtProduct.response.body.$.id}}/operations

### Přesun operace 2 nahoru: čekáme 204
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/operations/{{rtProductOperation2.response.body.$.id}}/move
Content-Type: application/json

{ "direction": -1 }

### Operace: pořadí se prohodilo (olepování je první)
GET {{host}}/api/products/{{rtProduct.response.body.$.id}}/operations

### Neplatný směr: čekáme 400
POST {{host}}/api/products/{{rtProduct.response.body.$.id}}/operations/{{rtProductOperation2.response.body.$.id}}/move
Content-Type: application/json

{ "direction": 5 }

### Odebrání operace: čekáme 204
DELETE {{host}}/api/products/{{rtProduct.response.body.$.id}}/operations/{{rtProductOperation1.response.body.$.id}}

### Odebrání materiálu: čekáme 204
DELETE {{host}}/api/products/{{rtProduct.response.body.$.id}}/materials/{{rtProductMaterial.response.body.$.id}}