@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Zakázkový systém</MudText>
    </MudAppBar>
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="customers" Icon="@Icons.Material.Filled.People">Zákazníci</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>