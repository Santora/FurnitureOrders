@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">Zakázkový systém</MudText>
    </MudAppBar>
    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="1">
        <MudNavMenu>
            <MudNavGroup Title="Evidence" Icon="@Icons.Material.Filled.Folder" Expanded="true">
                <MudNavLink Href="customers" Icon="@Icons.Material.Filled.People">Zákazníci</MudNavLink>
                <MudNavLink Href="customers/new" Icon="@Icons.Material.Filled.PersonAdd">Nový zákazník</MudNavLink>
                <MudNavLink Href="materials" Icon="@Icons.Material.Filled.Inventory2" >Materiály</MudNavLink>
                <MudNavLink Href="operations" Icon="@Icons.Material.Filled.Build" >Operace</MudNavLink>
                <MudNavLink Href="products" Icon="@Icons.Material.Filled.Chair" Disabled="true">Výrobky</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Zakázky" Icon="@Icons.Material.Filled.ReceiptLong" Expanded="true">
                <MudNavLink Href="orders" Icon="@Icons.Material.Filled.List" Disabled="true">Přehled zakázek</MudNavLink>
                <MudNavLink Href="orders/new" Icon="@Icons.Material.Filled.AddCircle" Disabled="true">Nová zakázka</MudNavLink>
                <MudNavLink Href="orders/ai" Icon="@Icons.Material.Filled.AutoAwesome" Disabled="true">Zakázka z poptávky (AI)</MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>