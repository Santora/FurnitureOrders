@page "/products/new"
@page "/products/{Id:int}/edit"
@inject ProductApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(IsNew ? "Nový výrobek" : "Úprava výrobku")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(IsNew ? "Nový výrobek" : "Úprava výrobku")</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    <MudButton Href="products" Variant="Variant.Outlined">Zpět na seznam</MudButton>
}
else if (_model is not null && _ctx is not null && _server is not null)
{
    <EditForm EditContext="_ctx" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ErrorList Messages="_server.General" />

        <FormSection Title="Základní údaje">
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_model.Code" For="@(() => _model.Code)" Label="Kód výrobku *" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)" Label="Název *" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="_model.Unit" For="@(() => _model.Unit)" Label="Měrná jednotka *" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Primary" Label="Aktivní" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudAutocomplete T="string" Label="Skupina výrobků" @bind-Value="_model.ProductGroup"
                                 SearchFunc="SearchGroups" CoerceText="false" CoerceValue="true"
                                 ShowProgressIndicator="false" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.ProductType" For="@(() => _model.ProductType)" Label="Typ výrobku" />
            </MudItem>
        </FormSection>

        <FormSection Title="Cena a dodání">
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal?" @bind-Value="_model.SalesPrice" For="@(() => _model.SalesPrice)"
                                 Label="Prodejní cena *" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="int?" @bind-Value="_model.DeliveryDays" For="@(() => _model.DeliveryDays)"
                                 Label="Doba dodání (dny)" HideSpinButtons="true" />
            </MudItem>
        </FormSection>

        <FormSection Title="Rozměry a hmotnost">
            <MudItem xs="12" md="3">
                <MudNumericField T="decimal?" @bind-Value="_model.Width" For="@(() => _model.Width)"
                                 Label="Šířka" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="decimal?" @bind-Value="_model.Height" For="@(() => _model.Height)"
                                 Label="Výška" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="decimal?" @bind-Value="_model.Depth" For="@(() => _model.Depth)"
                                 Label="Hloubka" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="decimal?" @bind-Value="_model.Weight" For="@(() => _model.Weight)"
                                 Label="Hmotnost" HideSpinButtons="true" />
            </MudItem>
        </FormSection>

        <FormSection Title="Popis a poznámka">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Popis" Lines="4" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Note" For="@(() => _model.Note)" Label="Poznámka" Lines="4" />
            </MudItem>
        </FormSection>

        <FormActions Saving="_saving" CancelHref="@(IsNew ? "products" : $"products/{Id}")" />
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private ProductEditDto? _model;
    private EditContext? _ctx;
    private ServerValidation? _server;
    private IReadOnlyList<string> _groups = [];
    private bool _loading;
    private bool _saving;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _groups = await Api.GroupsAsync();

        if (IsNew)
        {
            Init(new ProductEditDto());
            return;
        }

        _loading = true;
        var result = await Api.GetAsync(Id!.Value);
        _loading = false;

        if (result.IsSuccess)
        {
            Init(result.Value!);
        }
        else
        {
            _model = null;
            _error = result.Message ?? "Výrobek se nepodařilo načíst.";
        }
    }

    private void Init(ProductEditDto model)
    {
        _model = model;
        _ctx = new EditContext(model);
        _server = new ServerValidation(_ctx);
    }

    private Task<IEnumerable<string>> SearchGroups(string? text, CancellationToken ct) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? _groups.AsEnumerable()
            : _groups.Where(g => g.Contains(text, StringComparison.CurrentCultureIgnoreCase)));

    private async Task SaveAsync()
    {
        _saving = true;
        _server!.General.Clear();

        var result = IsNew
            ? await Api.CreateAsync(_model!)
            : await Api.UpdateAsync(Id!.Value, _model!);

        _saving = false;

        if (result.IsSuccess)
        {
            Snackbar.Add("Výrobek byl uložen.", Severity.Success);
            Nav.NavigateTo($"products/{result.Value!.Id}");
            return;
        }

        if (result.Errors.Count > 0) _server.Apply(result.Errors);
        else _server.General.Add(result.Message ?? "Uložení se nepodařilo.");
    }
}