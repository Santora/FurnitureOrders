@inject ProductRoutingApiClient Api
@inject OperationApiClient Operations

<EditForm EditContext="_ctx" OnValidSubmit="SaveAsync">
    <DataAnnotationsValidator />
    <MudDialog>
        <DialogContent>
            <ErrorList Messages="_server.General" />
            <MudGrid>
                <MudItem xs="12" md="9">
                    <MudAutocomplete T="OperationListItemDto" Label="Operace *" Value="_selected"
                                     ValueChanged="OnSelected" SearchFunc="SearchAsync"
                                     ToStringFunc="@(o => o is null ? string.Empty : $"{o.Code} – {o.Name}")"
                                     ResetValueOnEmptyText="true" Clearable="true"
                                     ShowProgressIndicator="false" />
                    <MudText HtmlTag="div" Typo="Typo.caption" Color="Color.Error">
                        <ValidationMessage For="@(() => _model.OperationId)" />
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudNumericField T="int?" @bind-Value="_model.Sequence" For="@(() => _model.Sequence)"
                                     Label="Pořadí" HelperText="Prázdné = na konec" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_model.Workplace" For="@(() => _model.Workplace)" Label="Pracoviště" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int?" @bind-Value="_model.SetupMinutes" For="@(() => _model.SetupMinutes)"
                                     Label="Doba přípravy (min)" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal?" @bind-Value="_model.RunMinutesPerUnit" For="@(() => _model.RunMinutesPerUnit)"
                                     Label="Doba výroby 1 ks (min)" HideSpinButtons="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.WorkInstructions" For="@(() => _model.WorkInstructions)"
                                  Label="Popis pracovního postupu" Lines="4" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_model.Note" For="@(() => _model.Note)" Label="Poznámka" Lines="2" />
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => MudDialog.Cancel())" Disabled="_saving">Zrušit</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">
                @(_saving ? "Ukládám…" : "Uložit")
            </MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public int ProductId { get; set; }
    [Parameter] public ProductOperationDto? Item { get; set; }

    private ProductOperationEditDto _model = new();
    private EditContext _ctx = default!;
    private ServerValidation _server = default!;
    private OperationListItemDto? _selected;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (Item is not null)
        {
            _model = new ProductOperationEditDto
            {
                OperationId = Item.OperationId,
                Sequence = Item.Sequence,
                Workplace = Item.Workplace,
                SetupMinutes = Item.SetupMinutes,
                RunMinutesPerUnit = Item.RunMinutesPerUnit,
                WorkInstructions = Item.WorkInstructions,
                Note = Item.Note
            };
            // jen pro zobrazení vybrané operace
            _selected = new OperationListItemDto(Item.OperationId, Item.OperationCode, Item.OperationName,
                Item.Workplace, null, null, null, null, true);
        }

        _ctx = new EditContext(_model);
        _server = new ServerValidation(_ctx);
    }

    private async Task<IEnumerable<OperationListItemDto>> SearchAsync(string? text, CancellationToken ct)
    {
        try
        {
            var items = await Operations.ListAsync(new OperationQuery(text, true, null, "name", false), ct);
            return items.Take(20);
        }
        catch (HttpRequestException)
        {
            return [];
        }
    }

    private void OnSelected(OperationListItemDto? operation)
    {
        _selected = operation;
        _model.OperationId = operation?.Id;

        if (operation is not null)
        {
            // výchozí hodnoty z evidence operací, uživatel je může přepsat
            _model.Workplace = operation.Workplace;
            _model.SetupMinutes = operation.DefaultSetupMinutes;
            _model.RunMinutesPerUnit = operation.DefaultRunMinutes;
        }

        _ctx.NotifyFieldChanged(_ctx.Field(nameof(ProductOperationEditDto.OperationId)));
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _server.General.Clear();

        var result = Item is null
            ? await Api.CreateOperationAsync(ProductId, _model)
            : await Api.UpdateOperationAsync(ProductId, Item.Id, _model);

        _saving = false;

        if (result.IsSuccess) MudDialog.Close(DialogResult.Ok(true));
        else if (result.Errors.Count > 0) _server.Apply(result.Errors);
        else _server.General.Add(result.Message ?? "Uložení se nepodařilo.");
    }
}