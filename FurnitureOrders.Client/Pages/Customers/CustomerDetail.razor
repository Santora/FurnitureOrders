@page "/customers/{Id:int}"
@inject CustomerApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Detail zákazníka</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    <MudButton Href="customers" Variant="Variant.Outlined">Zpět na seznam</MudButton>
}
else if (_c is not null)
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">@_c.Name</MudText>
            <ActiveChip IsActive="_c.IsActive" />
        </MudStack>
        <MudStack Row="true" Spacing="2">
            <MudButton Href="customers" Variant="Variant.Outlined">Zpět</MudButton>
            <MudButton OnClick="ToggleActiveAsync" Variant="Variant.Outlined"
                       Color="@(_c.IsActive ? Color.Warning : Color.Success)">
                @(_c.IsActive ? "Deaktivovat" : "Aktivovat")
            </MudButton>
            <MudButton Href="@($"customers/{_c.Id}/edit")" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit">Upravit</MudButton>
        </MudStack>
    </MudStack>

    <FormSection Title="Základní údaje">
        <DetailField Label="Číslo zákazníka" Value="@_c.CustomerNumber" />
        <DetailField Label="Typ" Value="@Labels.Of(_c.Type)" />
        <DetailField Label="IČO" Value="@_c.CompanyId" />
        <DetailField Label="DIČ" Value="@_c.VatId" />
    </FormSection>

    <FormSection Title="Kontakt">
        <DetailField Label="Kontaktní osoba" Value="@_c.ContactPerson" />
        <DetailField Label="E-mail" Value="@_c.Email" />
        <DetailField Label="Telefon" Value="@_c.Phone" />
    </FormSection>

    <FormSection Title="Adresa">
        <DetailField Label="Ulice" Value="@_c.Street" />
        <DetailField Label="Město" Value="@_c.City" />
        <DetailField Label="PSČ" Value="@_c.PostalCode" />
        <DetailField Label="Země" Value="@_c.Country" />
    </FormSection>

    <FormSection Title="Poznámka">
        <DetailField Label="Poznámka" Value="@_c.Note" Md="12" />
    </FormSection>
}

@code {
    [Parameter] public int Id { get; set; }

    private CustomerEditDto? _c;
    private bool _loading;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        var result = await Api.GetAsync(Id);
        _loading = false;

        if (result.IsSuccess) _c = result.Value;
        else
        {
            _c = null;
            _error = result.Message ?? "Zákazníka se nepodařilo načíst.";
        }
    }

    private async Task ToggleActiveAsync()
    {
        var result = await Api.SetActiveAsync(Id, !_c!.IsActive);
        if (result.IsSuccess)
        {
            _c = result.Value;
            Snackbar.Add("Stav zákazníka byl změněn.", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Message ?? "Změnu se nepodařilo uložit.", Severity.Error);
        }
    }
}