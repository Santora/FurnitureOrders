@page "/customers/new"
@page "/customers/{Id:int}/edit"
@inject CustomerApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(IsNew ? "Nový zákazník" : "Úprava zákazníka")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(IsNew ? "Nový zákazník" : "Úprava zákazníka")</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    <MudButton Href="customers" Variant="Variant.Outlined">Zpět na seznam</MudButton>
}
else if (_model is not null && _ctx is not null && _server is not null)
{
    <EditForm EditContext="_ctx" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ErrorList Messages="_server.General" />

        <FormSection Title="Základní údaje">
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.CustomerNumber" For="@(() => _model.CustomerNumber)"
                              Label="Číslo zákazníka"
                              HelperText="@(IsNew ? "Prázdné pole = číslo se vygeneruje automaticky." : null)" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="CustomerType" @bind-Value="_model.Type" Label="Typ zákazníka">
                    @foreach (var t in Enum.GetValues<CustomerType>())
                    {
                        <MudSelectItem T="CustomerType" Value="t">@Labels.Of(t)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Primary" Label="Aktivní" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)"
                              Label="@(_model.Type == CustomerType.Company ? "Název firmy *" : "Celé jméno *")" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="_model.CompanyId" For="@(() => _model.CompanyId)" Label="IČO" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="_model.VatId" For="@(() => _model.VatId)" Label="DIČ" />
            </MudItem>
        </FormSection>

        <FormSection Title="Kontakt">
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.ContactPerson" For="@(() => _model.ContactPerson)" Label="Kontaktní osoba" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.Email" For="@(() => _model.Email)" Label="E-mail" InputType="InputType.Email" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.Phone" For="@(() => _model.Phone)" Label="Telefon" InputType="InputType.Telephone" />
            </MudItem>
        </FormSection>

        <FormSection Title="Adresa">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Street" For="@(() => _model.Street)" Label="Ulice" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_model.City" For="@(() => _model.City)" Label="Město" />
            </MudItem>
            <MudItem xs="12" md="1">
                <MudTextField @bind-Value="_model.PostalCode" For="@(() => _model.PostalCode)" Label="PSČ" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudTextField @bind-Value="_model.Country" For="@(() => _model.Country)" Label="Země" />
            </MudItem>
        </FormSection>

        <FormSection Title="Poznámka">
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.Note" For="@(() => _model.Note)" Label="Poznámka" Lines="4" />
            </MudItem>
        </FormSection>

        <FormActions Saving="_saving" CancelHref="@(IsNew ? "customers" : $"customers/{Id}")" />
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private CustomerEditDto? _model;
    private EditContext? _ctx;
    private ServerValidation? _server;
    private bool _loading;
    private bool _saving;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;

        if (IsNew)
        {
            Init(new CustomerEditDto());
            return;
        }

        _loading = true;
        var result = await Api.GetAsync(Id!.Value);
        _loading = false;

        if (result.IsSuccess)
        {
            Init(result.Value!);
        }
        else
        {
            _model = null;
            _error = result.Message ?? "Zákazníka se nepodařilo načíst.";
        }
    }

    private void Init(CustomerEditDto model)
    {
        _model = model;
        _ctx = new EditContext(model);
        _server = new ServerValidation(_ctx);
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _server!.General.Clear();

        var result = IsNew
            ? await Api.CreateAsync(_model!)
            : await Api.UpdateAsync(Id!.Value, _model!);

        _saving = false;

        if (result.IsSuccess)
        {
            Snackbar.Add("Zákazník byl uložen.", Severity.Success);
            Nav.NavigateTo($"customers/{result.Value!.Id}");
            return;
        }

        if (result.Errors.Count > 0) _server.Apply(result.Errors);
        else _server.General.Add(result.Message ?? "Uložení se nepodařilo.");
    }
}