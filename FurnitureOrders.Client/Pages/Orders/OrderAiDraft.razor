@page "/orders/ai"
@inject OrderApiClient Api
@inject CustomerApiClient Customers
@inject ProductApiClient Products
@inject OrderDraftHandoff Handoff
@inject NavigationManager Nav

<PageTitle>Zakázka z poptávky</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Zakázka z poptávky (AI)</MudText>

@if (_status is not null && !_status.Enabled)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        AI služba není nakonfigurována. Zakázku můžete zadat ručně.
        <MudButton Href="orders/new" Variant="Variant.Text" Color="Color.Inherit">Nová zakázka</MudButton>
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudAutocomplete T="CustomerListItemDto" Label="Zákazník *" Value="_customer"
                             ValueChanged="@((CustomerListItemDto? c) => _customer = c)"
                             SearchFunc="SearchCustomersAsync" ToStringFunc="@CustomerText"
                             ResetValueOnEmptyText="true" Clearable="true" ShowProgressIndicator="false"
                             Disabled="_processing" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" @bind-Value="_text" Immediate="true" Lines="8"
                          Label="Text poptávky *" MaxLength="@_max" Counter="@_max" Disabled="_processing"
                          HelperText="Vložte text e-mailu nebo zprávy od zákazníka." />
        </MudItem>
        <MudItem xs="12">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanProcess)"
                           StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="ProcessAsync">
                    Zpracovat poptávku
                </MudButton>
                <MudButton Href="orders/new" Variant="Variant.Outlined" Disabled="_processing">Zadat ručně</MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_processing)
{
    <MudProgressLinear Indeterminate="true" Class="mb-1" />
    <MudText Typo="Typo.caption" Class="mb-4">Zpracovávám poptávku, může to trvat až několik desítek sekund…</MudText>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @_error Vložený text zůstal zachován.
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="ProcessAsync" Disabled="@(!CanProcess)">Zkusit znovu</MudButton>
        <MudButton Href="orders/new" Variant="Variant.Text" Color="Color.Inherit">Pokračovat ručně</MudButton>
    </MudAlert>
}

@if (_rows is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Návrh vytvořila AI, zkontrolujte ho. Nic se neukládá, dokud zakázku výslovně neuložíte ve formuláři zakázky.
        Ceny pocházejí z evidence výrobků, sleva je nulová.
    </MudAlert>

    @foreach (var warning in _warnings)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@warning</MudAlert>
    }

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Rozpoznané položky</MudText>

        @if (UnresolvedCount > 0)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                Nevyřešených položek: @UnresolvedCount. Přiřaďte je ke stávajícímu výrobku, nebo je odstraňte.
            </MudAlert>
        }

        <div style="overflow-x:auto">
            <MudSimpleTable Dense="true">
                <thead>
                    <tr>
                        <th>Zmínka v poptávce</th>
                        <th style="min-width:120px">Množství</th>
                        <th>Stav</th>
                        <th style="min-width:360px">Výrobek</th>
                        <th style="text-align:right">Jedn. cena</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        var (statusText, statusColor) = StatusOf(row);
                        <tr>
                            <td>
                                @row.Mention
                                @foreach (var w in row.Warnings)
                                {
                                    <div class="mud-typography mud-typography-caption mud-warning-text">@w</div>
                                }
                            </td>
                            <td>
                                <MudNumericField T="decimal?" @bind-Value="row.Quantity" HideSpinButtons="true"
                                                 Margin="Margin.Dense" Error="@(!(row.Quantity > 0))"
                                                 ErrorText="Doplňte množství" />
                            </td>
                            <td><MudChip T="string" Size="Size.Small" Color="@statusColor">@statusText</MudChip></td>
                            <td>
                                @if (row.Product is not null)
                                {
                                    <span>@row.Product.Code – @row.Product.Name</span>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => Unassign(row))">Změnit</MudButton>
                                }
                                else
                                {
                                    if (row.Candidates.Count > 0)
                                    {
                                        <MudStack Spacing="1" Class="mb-2">
                                            @foreach (var c in row.Candidates)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                           OnClick="@(() => Assign(row, c))">
                                                    @c.Code – @c.Name (@c.UnitPrice.ToString("N2"))
                                                </MudButton>
                                            }
                                        </MudStack>
                                    }
                                    <MudAutocomplete T="ProductListItemDto" Label="Přiřadit jiný výrobek"
                                                     Value="@((ProductListItemDto?)null)"
                                                     ValueChanged="@((ProductListItemDto? p) => AssignManual(row, p))"
                                                     SearchFunc="SearchProductsAsync" ToStringFunc="@ProductText"
                                                     ResetValueOnEmptyText="true" Clearable="true"
                                                     ShowProgressIndicator="false" Margin="Margin.Dense" />
                                }
                            </td>
                            <td style="text-align:right">@(row.Product is null ? "" : row.Product.UnitPrice.ToString("N2"))</td>
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" title="Odebrat položku"
                                               OnClick="@(() => _rows.Remove(row))" />
                            </td>
                        </tr>
                    }
                    @if (_rows.Count == 0)
                    {
                        <tr><td colspan="6" class="pa-4">V poptávce nebyl rozpoznán žádný výrobek. Položky doplníte ve formuláři zakázky.</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Další údaje z poptávky</MudText>
        <MudGrid>
            <MudItem xs="12" md="4">
                <DatePickerField Label="Požadovaný termín dodání" @bind-Value="_requiredDate" />
                @if (_requiredDate is null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">Termín chybí, doplňte ho (před uložením je povinný).</MudText>
                }
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField T="string" @bind-Value="_address" Label="Dodací adresa" Lines="2" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_note" Label="Poznámka" Lines="4" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(UnresolvedCount > 0 || _transferring)"
                   OnClick="TransferAsync">Převzít do formuláře zakázky</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Discard">Zahodit návrh</MudButton>
    </MudStack>
}

@code {
    private sealed class Row
    {
        public string Mention { get; init; } = "";
        public decimal? Quantity { get; set; }
        public DraftItemStatus Status { get; init; }
        public DraftProductDto? Product { get; set; }
        public List<DraftProductDto> Candidates { get; init; } = [];
        public List<string> Warnings { get; init; } = [];
    }

    private AiStatusDto? _status;
    private CustomerListItemDto? _customer;
    private string? _text;
    private int _max = 4000;
    private bool _processing;
    private bool _transferring;
    private string? _error;

    private List<Row>? _rows;
    private List<string> _warnings = [];
    private DateOnly? _requiredDate;
    private string? _address;
    private string? _note;

    private bool CanProcess =>
        !_processing && _customer is not null && !string.IsNullOrWhiteSpace(_text) && (_status?.Enabled ?? true);

    private int UnresolvedCount => _rows?.Count(r => r.Product is null) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        _status = await Api.GetAiStatusAsync();
        if (_status is not null) _max = _status.MaxInputLength;
    }

    private static string CustomerText(CustomerListItemDto? c) =>
        c is null ? string.Empty : $"{c.CustomerNumber} – {c.Name}";

    private static string ProductText(ProductListItemDto? p) =>
        p is null ? string.Empty : $"{p.Code} – {p.Name}";

    private async Task<IEnumerable<CustomerListItemDto>> SearchCustomersAsync(string? text, CancellationToken ct)
    {
        try
        {
            return (await Customers.ListAsync(new CustomerQuery(text, true, "name", false), ct)).Take(20);
        }
        catch (HttpRequestException)
        {
            return [];
        }
    }

    private async Task<IEnumerable<ProductListItemDto>> SearchProductsAsync(string? text, CancellationToken ct)
    {
        try
        {
            return (await Products.ListAsync(new ProductQuery(text, true, null, "name", false), ct)).Take(20);
        }
        catch (HttpRequestException)
        {
            return [];
        }
    }

    private async Task ProcessAsync()
    {
        if (!CanProcess) return;

        _processing = true;
        _error = null;
        _rows = null;

        var result = await Api.CreateDraftAsync(new OrderDraftRequest(_customer!.Id, _text));
        _processing = false;

        if (!result.IsSuccess)
        {
            _error = result.Errors.Count > 0
                ? string.Join(" ", result.Errors.SelectMany(e => e.Value))
                : result.Message ?? "Zpracování poptávky se nepodařilo.";
            return;
        }

        var draft = result.Value!;
        _rows = draft.Items.Select(i => new Row
        {
            Mention = i.Mention,
            Quantity = i.Quantity,
            Status = i.Status,
            Product = i.Product,
            Candidates = i.Candidates.ToList(),
            Warnings = i.Warnings.ToList()
        }).ToList();
        _warnings = draft.Warnings.ToList();
        _requiredDate = draft.RequiredDeliveryDate;
        _address = draft.DeliveryAddress;
        _note = draft.Note;
    }

    private static (string Text, Color Color) StatusOf(Row r) =>
        r.Product is null
            ? (r.Status == DraftItemStatus.Unknown ? ("Nenalezeno", Color.Error) : ("Vyberte výrobek", Color.Warning))
            : (r.Status == DraftItemStatus.Matched ? ("Přiřazeno", Color.Success) : ("Potvrzeno", Color.Info));

    private static void Assign(Row row, DraftProductDto product) => row.Product = product;

    private static void Unassign(Row row) => row.Product = null;

    private static void AssignManual(Row row, ProductListItemDto? p)
    {
        if (p is null) return;
        row.Product = new DraftProductDto(p.Id, p.Code, p.Name, p.Unit, p.SalesPrice);
    }

    private void Discard()
    {
        _rows = null;
        _warnings = [];
    }

    private static string? Clean(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task TransferAsync()
    {
        if (_rows is null || _customer is null || UnresolvedCount > 0) return;

        _transferring = true;

        var model = new OrderEditDto
        {
            CustomerId = _customer.Id,
            CustomerName = _customer.Name,
            CreatedDate = DateOnly.FromDateTime(DateTime.Today),
            RequiredDeliveryDate = _requiredDate,
            DeliveryAddress = Clean(_address),
            Note = Clean(_note)
        };

        var products = new Dictionary<OrderItemEditDto, ProductListItemDto?>();
        foreach (var row in _rows)
        {
            var p = row.Product!;
            var item = new OrderItemEditDto
            {
                ProductId = p.ProductId,
                ProductCode = p.Code,
                ProductName = p.Name,
                Description = row.Mention,
                Quantity = row.Quantity,
                Unit = p.Unit,
                UnitPrice = p.UnitPrice,   // cena vždy z evidence výrobků
                DiscountPercent = 0
            };
            model.Items.Add(item);
            products[item] = new ProductListItemDto(p.ProductId, p.Code, p.Name, null, null, p.Unit, p.UnitPrice, null, true);
        }

        if (model.Items.Count == 0)
            model.Items.Add(new OrderItemEditDto());

        // kontakt z karty zákazníka (stejně jako při ruční zakázce); adresa jen z textu poptávky
        var detail = await Customers.GetAsync(_customer.Id);
        if (detail.IsSuccess)
        {
            model.ContactPerson = detail.Value!.ContactPerson;
            model.Email = detail.Value.Email;
            model.Phone = detail.Value.Phone;
        }

        Handoff.Set(new OrderDraftHandoff.Draft(model, _customer, products));
        _transferring = false;
        Nav.NavigateTo("orders/new");
    }
}