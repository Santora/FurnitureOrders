@page "/operations/new"
@page "/operations/{Id:int}/edit"
@inject OperationApiClient Api
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(IsNew ? "Nová operace" : "Úprava operace")</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(IsNew ? "Nová operace" : "Úprava operace")</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    <MudButton Href="operations" Variant="Variant.Outlined">Zpět na seznam</MudButton>
}
else if (_model is not null && _ctx is not null && _server is not null)
{
    <EditForm EditContext="_ctx" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ErrorList Messages="_server.General" />

        <FormSection Title="Základní údaje">
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_model.Code" For="@(() => _model.Code)" Label="Kód operace *" />
            </MudItem>
            <MudItem xs="12" md="7">
                <MudTextField @bind-Value="_model.Name" For="@(() => _model.Name)" Label="Název *" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Primary" Label="Aktivní" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudAutocomplete T="string" Label="Pracoviště" @bind-Value="_model.Workplace"
                                 SearchFunc="SearchWorkplaces" CoerceText="false" CoerceValue="true"
                                 ShowProgressIndicator="false" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.OperationType" For="@(() => _model.OperationType)" Label="Typ operace" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_model.RequiredQualification" For="@(() => _model.RequiredQualification)"
                              Label="Požadovaná kvalifikace" />
            </MudItem>
        </FormSection>

        <FormSection Title="Časy a sazba">
            <MudItem xs="12" md="4">
                <MudNumericField T="int?" @bind-Value="_model.DefaultSetupMinutes" For="@(() => _model.DefaultSetupMinutes)"
                                 Label="Výchozí doba přípravy (min)" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="int?" @bind-Value="_model.DefaultRunMinutes" For="@(() => _model.DefaultRunMinutes)"
                                 Label="Výchozí doba výroby (min)" HideSpinButtons="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField T="decimal?" @bind-Value="_model.HourlyRate" For="@(() => _model.HourlyRate)"
                                 Label="Hodinová sazba" HideSpinButtons="true" />
            </MudItem>
        </FormSection>

        <FormSection Title="Popis a poznámka">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Description" For="@(() => _model.Description)" Label="Popis" Lines="4" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_model.Note" For="@(() => _model.Note)" Label="Poznámka" Lines="4" />
            </MudItem>
        </FormSection>

        <FormActions Saving="_saving" CancelHref="@(IsNew ? "operations" : $"operations/{Id}")" />
    </EditForm>
}

@code {
    [Parameter] public int? Id { get; set; }

    private bool IsNew => Id is null;
    private OperationEditDto? _model;
    private EditContext? _ctx;
    private ServerValidation? _server;
    private IReadOnlyList<string> _workplaces = [];
    private bool _loading;
    private bool _saving;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _workplaces = await Api.WorkplacesAsync();

        if (IsNew)
        {
            Init(new OperationEditDto());
            return;
        }

        _loading = true;
        var result = await Api.GetAsync(Id!.Value);
        _loading = false;

        if (result.IsSuccess)
        {
            Init(result.Value!);
        }
        else
        {
            _model = null;
            _error = result.Message ?? "Operaci se nepodařilo načíst.";
        }
    }

    private void Init(OperationEditDto model)
    {
        _model = model;
        _ctx = new EditContext(model);
        _server = new ServerValidation(_ctx);
    }

    private Task<IEnumerable<string>> SearchWorkplaces(string? text, CancellationToken ct) =>
        Task.FromResult(string.IsNullOrWhiteSpace(text)
            ? _workplaces.AsEnumerable()
            : _workplaces.Where(w => w.Contains(text, StringComparison.CurrentCultureIgnoreCase)));

    private async Task SaveAsync()
    {
        _saving = true;
        _server!.General.Clear();

        var result = IsNew
            ? await Api.CreateAsync(_model!)
            : await Api.UpdateAsync(Id!.Value, _model!);

        _saving = false;

        if (result.IsSuccess)
        {
            Snackbar.Add("Operace byla uložena.", Severity.Success);
            Nav.NavigateTo($"operations/{result.Value!.Id}");
            return;
        }

        if (result.Errors.Count > 0) _server.Apply(result.Errors);
        else _server.General.Add(result.Message ?? "Uložení se nepodařilo.");
    }
}