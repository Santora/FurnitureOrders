@page "/operations"
@inject OperationApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Operace</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Operace</MudText>

<ListToolbar NewHref="operations/new" NewText="Nová operace">
    <MudTextField T="string" Label="Hledat (kód, název)" Value="_search"
                  ValueChanged="OnSearchChanged" DebounceInterval="300"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true" Style="min-width:260px; flex:1" />
    <MudSelect T="string" Label="Pracoviště" Value="_workplace" ValueChanged="OnWorkplaceChanged" Style="max-width:240px">
        <MudSelectItem T="string" Value="@((string?)null)">Všechna</MudSelectItem>
        @foreach (var w in _workplaces)
        {
            <MudSelectItem T="string" Value="@w">@w</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="bool?" Label="Stav" Value="_isActive" ValueChanged="OnActiveChanged" Style="max-width:180px">
        <MudSelectItem T="bool?" Value="@((bool?)null)">Všechny</MudSelectItem>
        <MudSelectItem T="bool?" Value="@((bool?)true)">Aktivní</MudSelectItem>
        <MudSelectItem T="bool?" Value="@((bool?)false)">Neaktivní</MudSelectItem>
    </MudSelect>
</ListToolbar>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-2" />
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @_error
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadAsync">Zkusit znovu</MudButton>
    </MudAlert>
}
else
{
    <MudPaper Style="overflow-x:auto">
        <MudSimpleTable Hover="true" Dense="true">
            <thead>
                <tr>
                    <th><SortableHeader Text="Kód" Key="code" CurrentKey="@_sortBy" Desc="_desc" OnSort="SortAsync" /></th>
                    <th><SortableHeader Text="Název" Key="name" CurrentKey="@_sortBy" Desc="_desc" OnSort="SortAsync" /></th>
                    <th><SortableHeader Text="Pracoviště" Key="workplace" CurrentKey="@_sortBy" Desc="_desc" OnSort="SortAsync" /></th>
                    <th>Typ</th>
                    <th>Příprava (min)</th>
                    <th>Výroba (min)</th>
                    <th><SortableHeader Text="Sazba / h" Key="rate" CurrentKey="@_sortBy" Desc="_desc" OnSort="SortAsync" /></th>
                    <th>Stav</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in _items)
                {
                    <tr>
                        <td>@o.Code</td>
                        <td>@o.Name</td>
                        <td>@o.Workplace</td>
                        <td>@o.OperationType</td>
                        <td>@o.DefaultSetupMinutes</td>
                        <td>@o.DefaultRunMinutes</td>
                        <td>@o.HourlyRate?.ToString("N2")</td>
                        <td><ActiveChip IsActive="o.IsActive" /></td>
                        <td>
                            <RowActions DetailHref="@($"operations/{o.Id}")" EditHref="@($"operations/{o.Id}/edit")"
                                        IsActive="o.IsActive" OnToggleActive="@(() => ToggleActiveAsync(o))" />
                        </td>
                    </tr>
                }
                @if (_items.Count == 0 && !_loading)
                {
                    <tr><td colspan="9" class="pa-4">Žádné operace neodpovídají filtru.</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<OperationListItemDto> _items = [];
    private IReadOnlyList<string> _workplaces = [];
    private string? _search;
    private string? _workplace;
    private bool? _isActive;
    private string _sortBy = "code";
    private bool _desc;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _workplaces = await Api.WorkplacesAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _items = await Api.ListAsync(new OperationQuery(_search, _isActive, _workplace, _sortBy, _desc));
        }
        catch (HttpRequestException)
        {
            _error = "Seznam operací se nepodařilo načíst. Server není dostupný.";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task OnSearchChanged(string? v) { _search = v; return LoadAsync(); }
    private Task OnActiveChanged(bool? v) { _isActive = v; return LoadAsync(); }
    private Task OnWorkplaceChanged(string? v) { _workplace = v; return LoadAsync(); }

    private Task SortAsync(string key)
    {
        _desc = _sortBy == key && !_desc;
        _sortBy = key;
        return LoadAsync();
    }

    private async Task ToggleActiveAsync(OperationListItemDto o)
    {
        var result = await Api.SetActiveAsync(o.Id, !o.IsActive);
        if (result.IsSuccess)
        {
            Snackbar.Add(o.IsActive ? "Operace byla deaktivována." : "Operace byla aktivována.", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(result.Message ?? "Změnu se nepodařilo uložit.", Severity.Error);
        }
    }
}