@page "/grid/customers"
@inject CustomerApiClient Api

<PageTitle>Zákazníci (dynamický grid)</PageTitle>

@* Same pattern as GridOrders: row type + config name (wwwroot/grids/customers.json) + data source. *@
<DynamicGrid TItem="CustomerListItemDto" ConfigName="customers" LoadItems="LoadAsync" />

@code {
    private async Task<IReadOnlyList<CustomerListItemDto>> LoadAsync(CancellationToken ct) =>
        await Api.ListAsync(new CustomerQuery(null, null, "number", false), ct);
}