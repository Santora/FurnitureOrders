<MudPaper Class="pa-3 mb-4">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        @ChildContent
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" Href="@NewHref">@NewText</MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter, EditorRequired] public string NewHref { get; set; } = "";
    [Parameter] public string NewText { get; set; } = "Nový záznam";
}